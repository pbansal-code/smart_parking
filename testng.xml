<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Smart Parking Automation Suite" parallel="methods" thread-count="2">
    <listeners>
        <listener class-name="com.smartparking.listeners.TestListener" />
    </listeners>

    <!-- Smoke Test Suite -->
    <test name="Smoke Tests" enabled="true">
        <groups>
            <run>
                <include name="smoke" />
            </run>
        </groups>
        <packages>
            <package name="com.smartparking.tests" />
        </packages>
    </test>

    <!-- Functional Test Suite -->
    <test name="Functional Tests" enabled="true">
        <groups>
            <run>
                <include name="functional" />
            </run>
        </groups>
        <packages>
            <package name="com.smartparking.tests" />
        </packages>
    </test>

    <!-- Regression Test Suite -->
    <test name="Regression Tests" enabled="true">
        <groups>
            <run>
                <include name="regression" />
            </run>
        </groups>
        <packages>
            <package name="com.smartparking.tests" />
        </packages>
    </test>
</suite>